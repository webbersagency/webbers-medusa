    "@medusajs/icons": "^2.17.1",
    "@medusajs/js-sdk": "^2.17.1",
    "@medusajs/medusa": "^2.17.1",
    "@medusajs/test-utils": "^2.17.1",
    "@medusajs/types": "^2.17.1",
    "@medusajs/ui": "4.0.25",
    "@medusajs/workflows-sdk": "^2.17.1",
    "@swc/core": "1.5.7",
    "@tanstack/react-query": "5.64.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
