    "vite": "^5.4.21",
    "yalc": "1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.17.1",
    "@medusajs/admin-shared": "^2.17.1",
    "@medusajs/cli": "^2.17.1",
    "@medusajs/framework": "^2.17.1",
    "@medusajs/icons": "^2.17.1",
    "@medusajs/js-sdk": "^2.17.1",
    "@medusajs/medusa": "^2.17.1",
    "@medusajs/types": "^2.17.1",
    "@medusajs/ui": "^4.0.25",
    "@medusajs/workflows-sdk": "^2.17.1",
    "@tanstack/react-query": "5.64.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4 || ^7.0.0"
  },
  "engines": {
