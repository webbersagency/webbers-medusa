{
  "name": "@webbers/webbers-medusa",
  "displayName": "Medusa v2 Webbers QoL Plugin",
  "version": "1.2.3",
  "description": "Quality-of-life admin customizations for Medusa v2 (notes, customer anonymization, guest order transfer, price-list discount control, product reviews)",
  "author": "Webbers B.V. <development@webbers.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webbersagency/webbers-medusa.git"
  },
  "bugs": {
    "url": "https://github.com/webbersagency/webbers-medusa/issues"
  },
  "homepage": "https://github.com/webbersagency/webbers-medusa#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    ".medusa/server"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*/service": "./.medusa/server/src/modules/*/service.js",
    "./links": "./.medusa/server/src/links/index.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./*": "./.medusa/server/src/*.js"
  },
  "keywords": [
    "medusa-v2",
    "medusa-plugin-integration",
    "medusa-plugin-other",
    "reviews",
    "medusa-webbers"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "test": "node --test test/peer-dependencies.test.mjs",
    "prepublishOnly": "medusa plugin:build"
  },
  "dependencies": {
    "@hookform/resolvers": "3.4.2",
